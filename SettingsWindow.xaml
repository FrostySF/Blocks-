<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Blocks_.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Настройки">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" 
                Background="#1A1A1A" 
                Padding="20,15">
            <TextBlock Text="Настройки" 
                       FontSize="20" 
                       FontWeight="SemiBold"
                       Foreground="White"/>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="10">
            <StackPanel Spacing="20">

                <Border Background="#1A1A1A" 
                        CornerRadius="8" 
                        Padding="15"
                        BorderBrush="#2A2A2A"
                        BorderThickness="1">
                    <StackPanel Spacing="15">
                        <TextBlock Text="Сетка и позиционирование" 
                                   FontSize="16" 
                                   FontWeight="SemiBold"
                                   Foreground="#CCCCCC"/>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Размер шага сетки (px):" 
                                       Foreground="#999999"
                                       FontSize="13"/>
                            <NumberBox x:Name="GridStepNumberBox"
                                       Value="100"
                                       Minimum="20"
                                       Maximum="200"
                                       SpinButtonPlacementMode="Inline"
                                       SmallChange="10"
                                       LargeChange="20"/>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Радиус подсветки соседних ячеек:" 
                                       Foreground="#999999"
                                       FontSize="13"/>
                            <NumberBox x:Name="HighlightRadiusNumberBox"
                                       Value="1"
                                       Minimum="0"
                                       Maximum="5"
                                       SpinButtonPlacementMode="Inline"/>
                        </StackPanel>

                        <ToggleSwitch x:Name="ShowGridToggle"
                                      Header="Показывать сетку"
                                      IsOn="True"
                                      OnContent="Включено"
                                      OffContent="Выключено"/>
                    </StackPanel>
                </Border>

                <Border Background="#1A1A1A" 
                        CornerRadius="8" 
                        Padding="15"
                        BorderBrush="#2A2A2A"
                        BorderThickness="1">
                    <StackPanel Spacing="15">
                        <TextBlock Text="Отображение" 
                                   FontSize="16" 
                                   FontWeight="SemiBold"
                                   Foreground="#CCCCCC"/>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Тема приложения:" 
                                       Foreground="#999999"
                                       FontSize="13"/>
                            <ComboBox x:Name="ThemeComboBox"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="ThemeComboBox_SelectionChanged">
                                <ComboBoxItem Content="Тёмная" Tag="Dark"/>
                                <ComboBoxItem Content="Светлая" Tag="Light"/>
                                <ComboBoxItem Content="Системная" Tag="Default"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Цвет акцента:" 
                                       Foreground="#999999"
                                       FontSize="13"/>
                            <ComboBox x:Name="AccentColorComboBox"
                                      HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Синий (по умолчанию)" Tag="Blue"/>
                                <ComboBoxItem Content="Зелёный" Tag="Green"/>
                                <ComboBoxItem Content="Фиолетовый" Tag="Purple"/>
                                <ComboBoxItem Content="Красный" Tag="Red"/>
                                <ComboBoxItem Content="Оранжевый" Tag="Orange"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Чувствительность панорамирования:" 
                                       Foreground="#999999"
                                       FontSize="13"/>
                            <Slider x:Name="PanningSensitivitySlider"
                                    Minimum="1"
                                    Maximum="10"
                                    Value="3.5"
                                    StepFrequency="0.5"
                                    TickFrequency="1"
                                    TickPlacement="BottomRight"/>
                            <TextBlock x:Name="PanningSensitivityValue"
                                       Text="3.5"
                                       Foreground="#666666"
                                       FontSize="12"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Шаг масштабирования (%):" 
                                       Foreground="#999999"
                                       FontSize="13"/>
                            <NumberBox x:Name="ZoomStepNumberBox"
                                       Value="10"
                                       Minimum="5"
                                       Maximum="50"
                                       SpinButtonPlacementMode="Inline"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="#1A1A1A" 
                        CornerRadius="8" 
                        Padding="15"
                        BorderBrush="#2A2A2A"
                        BorderThickness="1">
                    <StackPanel Spacing="15">
                        <TextBlock Text="Поведение" 
                                   FontSize="16" 
                                   FontWeight="SemiBold"
                                   Foreground="#CCCCCC"/>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Максимум шагов отмены:" 
                                       Foreground="#999999"
                                       FontSize="13"/>
                            <NumberBox x:Name="MaxUndoStepsNumberBox"
                                       Value="50"
                                       Minimum="10"
                                       Maximum="200"
                                       SpinButtonPlacementMode="Inline"
                                       SmallChange="10"/>
                        </StackPanel>

                        <ToggleSwitch x:Name="AutoSaveToggle"
                                      Header="Автосохранение"
                                      IsOn="False"
                                      OnContent="Включено"
                                      OffContent="Выключено"/>

                        <StackPanel Spacing="8" Visibility="{x:Bind AutoSaveToggle.IsOn, Mode=OneWay}">
                            <TextBlock Text="Интервал автосохранения (мин):" 
                                       Foreground="#999999"
                                       FontSize="13"/>
                            <NumberBox x:Name="AutoSaveIntervalNumberBox"
                                       Value="5"
                                       Minimum="1"
                                       Maximum="30"
                                       SpinButtonPlacementMode="Inline"/>
                        </StackPanel>

                        <ToggleSwitch x:Name="SnapToGridToggle"
                                      Header="Привязка к сетке"
                                      IsOn="True"
                                      OnContent="Включено"
                                      OffContent="Выключено"/>

                        <ToggleSwitch x:Name="ShowNotificationsToggle"
                                      Header="Показывать уведомления"
                                      IsOn="True"
                                      OnContent="Включено"
                                      OffContent="Выключено"/>
                    </StackPanel>
                </Border>

                <Border Background="#1A1A1A" 
                        CornerRadius="8" 
                        Padding="15"
                        BorderBrush="#2A2A2A"
                        BorderThickness="1">
                    <StackPanel Spacing="15">
                        <TextBlock Text="Соединения" 
                                   FontSize="16" 
                                   FontWeight="SemiBold"
                                   Foreground="#CCCCCC"/>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Минимальная длина сегмента:" 
                                       Foreground="#999999"
                                       FontSize="13"/>
                            <NumberBox x:Name="MinSegmentLengthNumberBox"
                                       Value="10"
                                       Minimum="5"
                                       Maximum="50"
                                       SpinButtonPlacementMode="Inline"/>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Отступ от препятствий:" 
                                       Foreground="#999999"
                                       FontSize="13"/>
                            <NumberBox x:Name="ObstacleClearanceNumberBox"
                                       Value="15"
                                       Minimum="5"
                                       Maximum="50"
                                       SpinButtonPlacementMode="Inline"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" 
                Background="#1A1A1A" 
                Padding="20,15"
                BorderBrush="#2A2A2A"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Right"
                        Spacing="10">
                <Button Content="Сбросить по умолчанию" 
                        Click="ResetButton_Click"
                        Style="{StaticResource AccentButtonStyle}"/>
                <Button Content="Отмена" 
                        Click="CancelButton_Click"/>
                <Button Content="Сохранить" 
                        Click="SaveButton_Click"
                        Style="{StaticResource AccentButtonStyle}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
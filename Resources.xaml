<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Blocks_"
    xmlns:haru="using:Blocks_.haru">

    <!-- DataTemplate для блоков -->
    <DataTemplate x:Key="BlockItemTemplate" x:DataType="haru:BlockItem">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Основной контейнер блока -->
            <Border Grid.Row="0" 
                    Grid.RowSpan="3"
                    Background="{x:Bind BackgroundColor}" 
                    CornerRadius="6"
                    BorderThickness="1"
                    BorderBrush="#FF555555"
                    Padding="0"
                    Margin="0">
            </Border>

            <!-- Иконка блока (большая сверху) -->
            <Viewbox Grid.Row="0" 
                    MaxWidth="40" 
                    MaxHeight="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,8,0,0">
                <FontIcon Glyph="{x:Bind Icon}"
                         Foreground="White"
                         FontSize="24"/>
            </Viewbox>

            <!-- Название блока -->
            <TextBlock Grid.Row="1"
                      Text="{x:Bind Name}"
                      Foreground="White"
                      HorizontalAlignment="Center"
                      TextAlignment="Center"
                      Margin="8,4,8,2"
                      FontSize="12"
                      TextWrapping="Wrap"
                      MaxLines="2"
                      TextTrimming="CharacterEllipsis"/>

            <!-- Кнопка справки -->
            <Button Grid.Row="2"
                   Content="&#xE712;"
                   FontFamily="Segoe MDL2 Assets"
                   Foreground="#FFCCCCCC"
                   Background="Transparent"
                   BorderThickness="0"
                   Padding="2"
                   Margin="0,0,0,4"
                   HorizontalAlignment="Center"
                   Click="BlockInfoButton_Click"
                   Tag="{x:Bind}"
                   ToolTipService.ToolTip="Информация о блоке"
                   Width="24"
                   Height="24"
                   FontSize="10">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="CornerRadius" Value="12"/>
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="MinHeight" Value="0"/>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </DataTemplate>

    <!-- Стили для кнопок -->
    <Style x:Key="BlockButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Стили для текста -->
    <Style x:Key="BlockTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Стиль для ListViewItem -->
    <Style x:Key="BlockListViewItemStyle" TargetType="ListViewItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Width" Value="80"/>
        <Setter Property="Height" Value="90"/>
    </Style>

</ResourceDictionary>